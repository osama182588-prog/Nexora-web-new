# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/nexora

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-strong-secret

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Discord bot — required only for the external integration modules
# (activity broadcaster, tickets, admin controls). Without these, the
# modules can be enabled and configured in the dashboard but stay idle.
#
#  - DISCORD_BOT_TOKEN: from your Discord application's Bot tab
#  - DISCORD_PUBLIC_KEY: from the General Information tab; used to verify
#    the Ed25519 signature on every interaction webhook
#
# Set the application's "Interactions Endpoint URL" to:
#   ${NEXTAUTH_URL}/api/integration/discord/interactions
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
